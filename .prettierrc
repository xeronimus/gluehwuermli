{
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 120,
  "bracketSpacing": false,
  "arrowParens": "always",
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^react(-[a-z][a-z0-9-]*)?(/.*)?$",
    "<THIRD_PARTY_MODULES>",
    "^@shared/",
    "^@resources/",
    "^@/",
    "^[.]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
