# Copy to .env.development.local (gitignored) for `pnpm dev`; read by src/main/config.ts.
# Only variables prefixed MAIN_VITE_ reach the main process. They are compiled in, per mode:
# .env.development.local applies to `pnpm dev` only, never to `pnpm build` / `pnpm dist`.

# 1: one simulated port instead of the real serial ports, to work without a widget
MAIN_VITE_SIMULATED_OUTPUT=1
