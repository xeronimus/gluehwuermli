msgid "A channel has the same position twice"
msgstr "Ein Kanal hat dieselbe Position zweimal"

#: src/renderer/src/i18n/messages/fixtureMessages.ts
msgid "A channel with positions needs at least two of them"
msgstr "Ein Kanal mit Positionen braucht mindestens zwei davon"

#: src/renderer/src/i18n/messages/fixtureMessages.ts
msgid "A channel's min can't be above its max"
msgstr "Das Min. eines Kanals darf nicht über seinem Max. liegen"

#: src/renderer/src/i18n/messages/fixtureMessages.ts
msgid "A channel's step size must be a whole number from 1"
msgstr "Die Schrittweite eines Kanals muss eine ganze Zahl ab 1 sein"

#: src/renderer/src/i18n/messages/chaseMessages.ts
msgid "A chase can be played from {minRepeat} to {maxRepeat} times"
msgstr "Ein Chase lässt sich {minRepeat}- bis {maxRepeat}-mal spielen"

#: src/renderer/src/i18n/messages/chaseMessages.ts
