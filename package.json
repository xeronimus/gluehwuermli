{
  "name": "gluehwuermli",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app sending DMX through an Enttec DMX USB Pro",
  "author": "Sergio Trentini",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "test": "pnpm run typecheck && vitest run",
    "test:watch": "vitest",
    "format": "node ./scripts/normalizeImports.mjs && prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,mts}\" \"scripts/**/*.mjs\" \"*.md\" \"doc/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,mts}\" \"scripts/**/*.mjs\" \"*.md\" \"doc/**/*.md\"",
    "ft": "pnpm run format && pnpm run test"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.49.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "loglevel": "^1.9.2",
    "normalize.css": "^8.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-range": "^1.10.0",
    "reselect": "^5.3.0",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
