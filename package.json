{
  "name": "gluehwuermli",
  "version": "0.4.1",
  "private": true,
  "description": "Desktop app sending DMX through an Enttec DMX USB Pro or a Eurolite USB-DMX512 PRO",
  "author": "Sergio Trentini",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac -c.productName=gluehwuermli",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p ghpage/tsconfig.json",
    "test": "pnpm run i18n:extract && pnpm run typecheck && vitest run && pnpm run i18n:compile",
    "test:watch": "vitest",
    "format": "node ./scripts/normalizeImports.mjs && prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,mts}\" \"scripts/**/*.mjs\" \"*.md\" \"doc/**/*.md\" \"ghpage/**/*.{ts,mts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,mts}\" \"scripts/**/*.mjs\" \"*.md\" \"doc/**/*.md\" \"ghpage/**/*.{ts,mts,tsx,css}\"",
    "ft": "pnpm run format && pnpm run test",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.7.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/core": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@lingui/vite-plugin": "^6.7.0",
    "@tabler/icons-react": "^3.49.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0",
    "loglevel": "^1.9.2",
    "normalize.css": "^8.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-range": "^1.10.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "reselect": "^5.3.0",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
