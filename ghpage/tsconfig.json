{
  // the landing page and its build; type checked by the app's `pnpm typecheck`, together with the app's topic
  // components it renders
  "compilerOptions": {
    "target": "es2023",
    "lib": ["dom", "es2023"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src", "*.ts", "*.mts"]
}
